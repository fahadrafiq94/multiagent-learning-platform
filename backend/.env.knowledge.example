# Create backend/.env.knowledge with:
#   python backend/scripts/knowledge_infra.py init
# The helper generates unique passwords and never overwrites an existing file.
# This file is Compose configuration, not backend runtime configuration.
# PostgreSQL initialization consumes passwords only on its FIRST empty-volume start.
# Changing these values later does not rotate existing database-role passwords.
KNOWLEDGE_POSTGRES_PASSWORD=replace-with-a-unique-random-password
KNOWLEDGE_WRITER_PASSWORD=replace-with-another-unique-random-password
KNOWLEDGE_READER_PASSWORD=replace-with-another-unique-random-password
KNOWLEDGE_REDIS_PASSWORD=replace-with-another-unique-random-password

# Added atomically by: python -m scripts.bootstrap_application (from backend).
# Existing knowledge credentials are preserved; these use separate database roles.
APPLICATION_MIGRATOR_PASSWORD=provision-with-bootstrap-application
APPLICATION_RUNTIME_PASSWORD=provision-with-bootstrap-application
APPLICATION_PILOT_AUTH_SECRET=provision-with-bootstrap-application

# Localhost-only ports used by docker-compose.knowledge.dev.yml.
KNOWLEDGE_POSTGRES_PORT=15432
KNOWLEDGE_REDIS_PORT=16379

# Optional RAG overlay consumes KNOWLEDGE_REDIS_PASSWORD above for cache access.
# Feature switches are explicit; enabling cache does not enable student RAG.
KNOWLEDGE_CACHE_ENABLED=false
