APP_NAME=Multiagent Learning Platform
APP_VERSION=0.5.0
APP_ENV=development
LOG_LEVEL=INFO
# Optional JSON-lines research export of request events (4B.10).
# Leave unset to disable; events still appear in the application log.
#OBSERVABILITY_LOG_FILE=/tmp/fredi-request-events.jsonl
# Durable deployment path/volume; bounded per-process retention (10 MiB x 6 files).
#OBSERVABILITY_LOG_MAX_BYTES=10485760
#OBSERVABILITY_LOG_BACKUP_COUNT=5

MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe

MODEL_REQUEST_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
MODEL_RETRY_BACKOFF_SECONDS=0.5
MODEL_TEMPERATURE=0.2

CONTEXT_MAX_TOKENS=8192
CONTEXT_RESERVED_OUTPUT_TOKENS=2048
CONTEXT_MAX_RECENT_MESSAGES=20
CONTEXT_CHARACTERS_PER_TOKEN=4.0
CONTEXT_MESSAGE_OVERHEAD_TOKENS=4

# Session summary (Sprint 4B.8)
# Optional dedicated model for summary updates; empty = default chat model.
SUMMARY_MODEL=
# Messages that must fall out of the recent window before a summary update runs.
CONTEXT_SUMMARY_MIN_NEW_MESSAGES=4
# Maximum items per structured list in the persisted summary.
CONTEXT_SUMMARY_MAX_ITEMS_PER_LIST=10
# Maximum characters for the persisted summary overview.
CONTEXT_SUMMARY_MAX_OVERVIEW_CHARS=1200

# Optional knowledge containers are configured separately in .env.knowledge.
# From the repository root: python backend/scripts/knowledge_infra.py init
# Checkpoint 1 adds infrastructure only; backend retrieval/caching are not enabled.

# Durable HTTP chat: include docker-compose.application.yml after knowledge overlays.
# It supplies APPLICATION_STORAGE=postgres and the protected database/signing secrets.
# Standalone memory mode is for tests/development; never falls back after DB failures.
APPLICATION_STORAGE=memory
APPLICATION_DATABASE_POOL_SIZE=4
# For native execution, inject APPLICATION_DATABASE_URL and
# APPLICATION_PILOT_AUTH_SECRET through protected process configuration (not git).
# Experimental RAG (off by default). Bindings are trusted server configuration.
RAG_ENABLED=false
KNOWLEDGE_CACHE_ENABLED=false
# Native retrieval cache (Docker overlay supplies its internal host/port/password):
# KNOWLEDGE_CACHE_REDIS_HOST=127.0.0.1
# KNOWLEDGE_CACHE_REDIS_PORT=16379
# KNOWLEDGE_CACHE_REDIS_PASSWORD=inject-from-protected-local-credentials
# KNOWLEDGE_CACHE_TTL_SECONDS=3600
# KNOWLEDGE_CACHE_TTL_JITTER_SECONDS=300
# KNOWLEDGE_CACHE_OPERATION_TIMEOUT_SECONDS=0.1
# KNOWLEDGE_CACHE_MAX_PAYLOAD_BYTES=262144
KNOWLEDGE_INTAKE_ENABLED=false
# KNOWLEDGE_INTAKE_CONFIG_FILE=/absolute/path/to/.knowledge-intake.json
# KNOWLEDGE_SOURCE_ROOT=/absolute/path/to/protected-sources
# KNOWLEDGE_INGEST_DATABASE_URL=postgresql://writer:secret@host/database
# RAG_CONFIG_FILE=/absolute/path/to/.rag-runtime.json
# RAG_DATABASE_URL is a protected knowledge-reader DSN, or use the optional Compose overlay.
