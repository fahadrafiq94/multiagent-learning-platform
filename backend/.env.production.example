# Template for the production environment file.
#
# The production compose stack loads `backend/.env.production`
# (see docker/compose/docker-compose.prod.yml). Copy this file to
# `backend/.env.production` and fill in real values before running
# `make prod-up`. `backend/.env.production` is git-ignored.

APP_NAME=Multiagent Learning Platform
APP_VERSION=0.5.0
APP_ENV=production
LOG_LEVEL=INFO

MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe

MODEL_REQUEST_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
MODEL_RETRY_BACKOFF_SECONDS=0.5
MODEL_TEMPERATURE=0.2

CONTEXT_MAX_TOKENS=8192
CONTEXT_RESERVED_OUTPUT_TOKENS=2048
CONTEXT_MAX_RECENT_MESSAGES=20
CONTEXT_CHARACTERS_PER_TOKEN=4.0
CONTEXT_MESSAGE_OVERHEAD_TOKENS=4

# Session summary (Sprint 4B.8)
# Optional dedicated model for summary updates; empty = default chat model.
SUMMARY_MODEL=
# Messages that must fall out of the recent window before a summary update runs.
CONTEXT_SUMMARY_MIN_NEW_MESSAGES=4
# Maximum items per structured list in the persisted summary.
CONTEXT_SUMMARY_MAX_ITEMS_PER_LIST=10
# Maximum characters for the persisted summary overview.
CONTEXT_SUMMARY_MAX_OVERVIEW_CHARS=1200

# Optional research export: one JSON event per line; empty = off.
OBSERVABILITY_LOG_FILE=

# Optional knowledge services: see docs/operations/knowledge-infrastructure.md.
# Use deployment-specific .env.knowledge credentials with the knowledge Compose
# overlay; never reuse the development credentials on a production host.

# Use the application Compose overlay to activate durable chat, after migrations.
# Inject APPLICATION_DATABASE_URL (runtime role) and APPLICATION_PILOT_AUTH_SECRET
# through protected deployment configuration. Never use example passwords.
APPLICATION_STORAGE=postgres
APPLICATION_DATABASE_POOL_SIZE=4
# RAG stays opt-in; validate model quality/capacity before enabling a pilot.
RAG_ENABLED=false
KNOWLEDGE_CACHE_ENABLED=false
# KNOWLEDGE_CACHE_REDIS_HOST=redis
# KNOWLEDGE_CACHE_REDIS_PORT=6379
# KNOWLEDGE_CACHE_REDIS_PASSWORD=inject-through-deployment-secrets
# KNOWLEDGE_CACHE_TTL_SECONDS=3600
# KNOWLEDGE_CACHE_TTL_JITTER_SECONDS=300
# KNOWLEDGE_CACHE_OPERATION_TIMEOUT_SECONDS=0.1
# KNOWLEDGE_CACHE_MAX_PAYLOAD_BYTES=262144
KNOWLEDGE_INTAKE_ENABLED=false
# KNOWLEDGE_INTAKE_CONFIG_FILE=/run/config/knowledge-intake.json
# KNOWLEDGE_SOURCE_ROOT=/sources
# KNOWLEDGE_INGEST_DATABASE_URL=postgresql://writer:secret@host/database
# RAG_CONFIG_FILE=/run/config/rag-runtime.json
# RAG_DATABASE_URL must use a read-only knowledge role, separate from application storage.
