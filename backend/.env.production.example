# Template for the production environment file.
#
# The production compose stack loads `backend/.env.production`
# (see docker/compose/docker-compose.prod.yml). Copy this file to
# `backend/.env.production` and fill in real values before running
# `make prod-up`. `backend/.env.production` is git-ignored.

APP_NAME=Multiagent Learning Platform
APP_VERSION=0.5.0
APP_ENV=production
LOG_LEVEL=INFO

MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe

MODEL_REQUEST_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
MODEL_RETRY_BACKOFF_SECONDS=0.5
MODEL_TEMPERATURE=0.2

CONTEXT_MAX_TOKENS=8192
CONTEXT_RESERVED_OUTPUT_TOKENS=2048
CONTEXT_MAX_RECENT_MESSAGES=20
CONTEXT_CHARACTERS_PER_TOKEN=4.0
CONTEXT_MESSAGE_OVERHEAD_TOKENS=4

# Session summary (Sprint 4B.8)
# Optional dedicated model for summary updates; empty = default chat model.
SUMMARY_MODEL=
# Messages that must fall out of the recent window before a summary update runs.
CONTEXT_SUMMARY_MIN_NEW_MESSAGES=4
# Maximum items per structured list in the persisted summary.
CONTEXT_SUMMARY_MAX_ITEMS_PER_LIST=10
# Maximum characters for the persisted summary overview.
CONTEXT_SUMMARY_MAX_OVERVIEW_CHARS=1200

# Optional research export: one JSON event per line; empty = off.
OBSERVABILITY_LOG_FILE=
